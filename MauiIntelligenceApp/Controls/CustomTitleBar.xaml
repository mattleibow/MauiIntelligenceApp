<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:f="clr-namespace:Fonts"
             x:Class="MauiIntelligenceApp.Controls.CustomTitleBar">
    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
          HeightRequest="60"
          Padding="10,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>

        <!-- Hamburger Menu / Back Button -->
        <ImageButton Grid.Column="0"
                     x:Name="MenuButton"
                     WidthRequest="40"
                     HeightRequest="40"
                     CornerRadius="20"
                     Padding="8"
                     BackgroundColor="Transparent"
                     Clicked="OnMenuButtonClicked">
            <ImageButton.Source>
                <FontImageSource FontFamily="{x:Static f:FluentUI.FontFamily}"
                                 Glyph="{x:Static f:FluentUI.navigation_24_regular}"
                                 Size="24"
                                 Color="White" />
            </ImageButton.Source>
        </ImageButton>

        <!-- Center Content: App Title and Search Box -->
        <VerticalStackLayout Grid.Column="1"
                             Spacing="4"
                             VerticalOptions="Center"
                             Margin="10,0">
            
            <!-- App Title -->
            <Label Text="Intelligence App"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="End" />

            <!-- Search Box -->
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#40FFFFFF, Dark=#40FFFFFF}"
                    Padding="0"
                    HeightRequest="32"
                    StrokeShape="RoundRectangle 16">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="8"
                      Padding="10,0">
                    
                    <!-- Search Icon -->
                    <Image Grid.Column="0"
                           WidthRequest="16"
                           HeightRequest="16"
                           VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource FontFamily="{x:Static f:FluentUI.FontFamily}"
                                             Glyph="{x:Static f:FluentUI.search_16_regular}"
                                             Size="16"
                                             Color="White" />
                        </Image.Source>
                    </Image>

                    <!-- Search Entry -->
                    <Entry Grid.Column="1"
                           x:Name="SearchEntry"
                           Placeholder="Search projects, tasks..."
                           PlaceholderColor="#CCFFFFFF"
                           TextColor="White"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           TextChanged="OnSearchTextChanged" />

                    <!-- Clear Button -->
                    <ImageButton Grid.Column="2"
                                 x:Name="ClearButton"
                                 WidthRequest="16"
                                 HeightRequest="16"
                                 IsVisible="False"
                                 BackgroundColor="Transparent"
                                 Padding="0"
                                 Clicked="OnClearButtonClicked"
                                 VerticalOptions="Center">
                        <ImageButton.Source>
                            <FontImageSource FontFamily="{x:Static f:FluentUI.FontFamily}"
                                             Glyph="{x:Static f:FluentUI.dismiss_circle_16_regular}"
                                             Size="16"
                                             Color="White" />
                        </ImageButton.Source>
                    </ImageButton>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Optional Right Button (e.g., settings, notifications) -->
        <ImageButton Grid.Column="2"
                     x:Name="OptionsButton"
                     WidthRequest="40"
                     HeightRequest="40"
                     CornerRadius="20"
                     Padding="8"
                     BackgroundColor="Transparent"
                     Clicked="OnOptionsButtonClicked"
                     IsVisible="False">
            <ImageButton.Source>
                <FontImageSource FontFamily="{x:Static f:FluentUI.FontFamily}"
                                 Glyph="{x:Static f:FluentUI.more_vertical_24_regular}"
                                 Size="24"
                                 Color="White" />
            </ImageButton.Source>
        </ImageButton>
    </Grid>
</ContentView>
